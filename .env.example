# LLM API Keys (at least one required for AI answers)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ngrok API Key (required for ngrok-mcp server)
NGROK_API_KEY=your-ngrok-api-key-here

# Slack Bot Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Zendesk Credentials (required for /ngrok-ticket)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@company.com
ZENDESK_API_TOKEN=your-zendesk-api-token

# Datadog On-Call Paging (required for 🚨 reaction paging)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
# Regional URL — defaults to US. Change for EU/APAC deployments.
# EU: https://beige.oncall.datadoghq.eu/api/v2/on-call/pages
# APAC: https://saffron.oncall.datadoghq.com/api/v2/on-call/pages
DATADOG_ONCALL_URL=https://navy.oncall.datadoghq.com/api/v2/on-call/pages
